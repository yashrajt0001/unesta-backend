# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/unesta_dev"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"

# Cloudflare R2 (S3-compatible object storage)
# Account ID: Cloudflare dashboard → R2 → Overview (right sidebar)
R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2 → Manage API tokens → Create API token → Object Read & Write, scoped to the bucket
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="unesta"
# Public read origin. Custom domain in production (https://cdn.unesta.com),
# the bucket's r2.dev subdomain in development. No trailing slash.
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxx.r2.dev"

# Frontend URLs (for CORS)
WEB_APP_URL="http://localhost:3000"
HOST_APP_URL="http://localhost:3001"
ADMIN_APP_URL="http://localhost:3002"

# OTP
OTP_EXPIRY_MINUTES=10

# Google Maps — SERVER key (geocoding etc). MUST be a different key from the
# browser one. Restrict by server IP + Geocoding API only. Never sent to client.
GOOGLE_MAPS_SERVER_KEY="your-server-restricted-maps-key"
